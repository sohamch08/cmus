# Catppuccin Macchiato for cmus
# Palette: https://catppuccin.com/palette/
# Uses xterm-256 approximations; cmus 2.12 does not accept RGB hex values.
# Text colors are adjusted to maintain at least 4.5:1 contrast.
# Each comment records the original palette color and hex value.

# Windows and album headings
# base: #24273a
set color_win_bg=235
# text: #cad3f5
set color_win_fg=189
set color_win_attr=default
# surface1: #494d64
set color_separator=239
# blue: #8aadf4
set color_win_dir=111
# base: #24273a
set color_trackwin_album_bg=235
# mauve: #c6a0f6
set color_trackwin_album_fg=147
set color_trackwin_album_attr=bold

# Window headers
# mantle: #1e2030
set color_win_title_bg=235
# mauve: #c6a0f6
set color_win_title_fg=147
set color_win_title_attr=bold

# Playing track
# green: #a6da95
set color_win_cur=150
set color_win_cur_attr=bold

# Focused selection
# mauve: #c6a0f6
set color_win_sel_bg=147
# crust: #181926
set color_win_sel_fg=234
set color_win_sel_attr=default
# mauve: #c6a0f6
set color_win_cur_sel_bg=147
# crust: #181926
set color_win_cur_sel_fg=234
set color_win_cur_sel_attr=bold
set color_cur_sel_attr=bold

# Inactive selection
# surface0: #363a4f
set color_win_inactive_sel_bg=237
# text: #cad3f5
set color_win_inactive_sel_fg=189
set color_win_inactive_sel_attr=default
# surface1: #494d64
set color_win_inactive_cur_sel_bg=239
# green: #a6da95
set color_win_inactive_cur_sel_fg=150
set color_win_inactive_cur_sel_attr=bold

# Now playing and status
# mantle: #1e2030
set color_titleline_bg=235
# text: #cad3f5
set color_titleline_fg=189
set color_titleline_attr=bold
# mantle: #1e2030
set color_statusline_bg=235
# subtext1: #b8c0e0
set color_statusline_fg=146
set color_statusline_attr=default
# mauve: #c6a0f6
set color_statusline_progress_bg=147
# crust: #181926
set color_statusline_progress_fg=234
set color_statusline_progress_attr=default

# Command line and messages
# base: #24273a
set color_cmdline_bg=235
# text: #cad3f5
set color_cmdline_fg=189
set color_cmdline_attr=default
# red: #ed8796
set color_error=210
# blue: #8aadf4
set color_info=111
