# Catppuccin Frappé for cmus
# Palette: https://catppuccin.com/palette/
# Uses xterm-256 approximations; cmus 2.12 does not accept RGB hex values.
# Text colors are adjusted to maintain at least 4.5:1 contrast.
# Each comment records the original palette color and hex value.

# Windows and album headings
# base: #303446
set color_win_bg=237
# text: #c6d0f5
set color_win_fg=153
set color_win_attr=default
# surface1: #51576d
set color_separator=240
# blue: #8caaee
set color_win_dir=111
# base: #303446
set color_trackwin_album_bg=237
# mauve: #ca9ee6
set color_trackwin_album_fg=183
set color_trackwin_album_attr=bold

# Window headers
# mantle: #292c3c
set color_win_title_bg=236
# mauve: #ca9ee6
set color_win_title_fg=183
set color_win_title_attr=bold

# Playing track
# green: #a6d189
set color_win_cur=150
set color_win_cur_attr=bold

# Focused selection
# mauve: #ca9ee6
set color_win_sel_bg=183
# crust: #232634
set color_win_sel_fg=235
set color_win_sel_attr=default
# mauve: #ca9ee6
set color_win_cur_sel_bg=183
# crust: #232634
set color_win_cur_sel_fg=235
set color_win_cur_sel_attr=bold
set color_cur_sel_attr=bold

# Inactive selection
# surface0: #414559
set color_win_inactive_sel_bg=238
# text: #c6d0f5
set color_win_inactive_sel_fg=153
set color_win_inactive_sel_attr=default
# surface1: #51576d
set color_win_inactive_cur_sel_bg=240
# green: #a6d189
set color_win_inactive_cur_sel_fg=186
set color_win_inactive_cur_sel_attr=bold

# Now playing and status
# mantle: #292c3c
set color_titleline_bg=236
# text: #c6d0f5
set color_titleline_fg=153
set color_titleline_attr=bold
# mantle: #292c3c
set color_statusline_bg=236
# subtext1: #b5bfe2
set color_statusline_fg=146
set color_statusline_attr=default
# mauve: #ca9ee6
set color_statusline_progress_bg=183
# crust: #232634
set color_statusline_progress_fg=235
set color_statusline_progress_attr=default

# Command line and messages
# base: #303446
set color_cmdline_bg=237
# text: #c6d0f5
set color_cmdline_fg=153
set color_cmdline_attr=default
# red: #e78284
set color_error=210
# blue: #8caaee
set color_info=111
