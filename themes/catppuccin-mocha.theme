# Catppuccin Mocha for cmus
# Palette: https://catppuccin.com/palette/
# Uses xterm-256 approximations; cmus 2.12 does not accept RGB hex values.
# Text colors are adjusted to maintain at least 4.5:1 contrast.
# Each comment records the original palette color and hex value.

# Windows and album headings
# base: #1e1e2e
set color_win_bg=234
# text: #cdd6f4
set color_win_fg=189
set color_win_attr=default
# surface1: #45475a
set color_separator=238
# blue: #89b4fa
set color_win_dir=111
# base: #1e1e2e
set color_trackwin_album_bg=234
# mauve: #cba6f7
set color_trackwin_album_fg=183
set color_trackwin_album_attr=bold

# Window headers
# mantle: #181825
set color_win_title_bg=234
# mauve: #cba6f7
set color_win_title_fg=183
set color_win_title_attr=bold

# Playing track
# green: #a6e3a1
set color_win_cur=150
set color_win_cur_attr=bold

# Focused selection
# mauve: #cba6f7
set color_win_sel_bg=183
# crust: #11111b
set color_win_sel_fg=233
set color_win_sel_attr=default
# mauve: #cba6f7
set color_win_cur_sel_bg=183
# crust: #11111b
set color_win_cur_sel_fg=233
set color_win_cur_sel_attr=bold
set color_cur_sel_attr=bold

# Inactive selection
# surface0: #313244
set color_win_inactive_sel_bg=236
# text: #cdd6f4
set color_win_inactive_sel_fg=189
set color_win_inactive_sel_attr=default
# surface1: #45475a
set color_win_inactive_cur_sel_bg=238
# green: #a6e3a1
set color_win_inactive_cur_sel_fg=150
set color_win_inactive_cur_sel_attr=bold

# Now playing and status
# mantle: #181825
set color_titleline_bg=234
# text: #cdd6f4
set color_titleline_fg=189
set color_titleline_attr=bold
# mantle: #181825
set color_statusline_bg=234
# subtext1: #bac2de
set color_statusline_fg=251
set color_statusline_attr=default
# mauve: #cba6f7
set color_statusline_progress_bg=183
# crust: #11111b
set color_statusline_progress_fg=233
set color_statusline_progress_attr=default

# Command line and messages
# base: #1e1e2e
set color_cmdline_bg=234
# text: #cdd6f4
set color_cmdline_fg=189
set color_cmdline_attr=default
# red: #f38ba8
set color_error=211
# blue: #89b4fa
set color_info=111
