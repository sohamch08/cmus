# Clear saved album-heading colors before applying the theme.
# Spotify leaves these unset; other themes may override them below.
set color_trackwin_album_bg=default
set color_trackwin_album_fg=default
colorscheme spotify

# Audio output
set output_plugin=pulse
set mixer.pulse.restore_volume=1

# Music Directory
add -l ~/Music

# Sort library and playlists by title
set play_sorted=true
set lib_sort=title
set pl_sort=title

# Playback
set repeat=true
set show_remaining_time=true
set aaa_mode=all

# Open in the sorted library view (2)
set start_view=sorted


# Pause when the audio output device changes
set pause_on_output_change=true

# Balance loudness when tracks have ReplayGain tags
set replaygain=smart
set replaygain_limit=true
set replaygain_preamp=0

# Keep the playback footer free of bitrate details
set show_current_bitrate=false

source ~/.config/cmus/bindings.conf
source ~/.config/cmus/appearance.conf

# Start notifications once alongside cmus
shell pgrep -u "$(id -u)" -x cmus-notify >/dev/null || "$HOME/.cargo/bin/cmus-notify" --link --cover --timeout 3
